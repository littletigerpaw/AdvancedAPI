{
  "info": {
    "name": "Mechanic Shop API - BackendP2",
    "description": "Collection covering customer auth, tickets, mechanics, and inventory endpoints for the assignment continuation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Customers",
      "item": [
        {
          "name": "Create Customer",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Token User\",\n  \"email\": \"token@example.com\",\n  \"phone\": \"111-222-3333\",\n  \"password\": \"secret123\"\n}"
            },
            "url": {
              "raw": "http://127.0.0.1:5000/customers/",
              "protocol": "http",
              "host": ["127.0.0.1"],
              "port": "5000",
              "path": ["customers", ""]
            }
          }
        },
        {
          "name": "Customer Login",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"token@example.com\",\n  \"password\": \"secret123\"\n}"
            },
            "url": {
              "raw": "http://127.0.0.1:5000/customers/login",
              "protocol": "http",
              "host": ["127.0.0.1"],
              "port": "5000",
              "path": ["customers", "login"]
            }
          }
        },
        {
          "name": "My Tickets",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "url": {
              "raw": "http://127.0.0.1:5000/customers/my-tickets",
              "protocol": "http",
              "host": ["127.0.0.1"],
              "port": "5000",
              "path": ["customers", "my-tickets"]
            }
          }
        },
        {
          "name": "Get Customers",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://127.0.0.1:5000/customers/?page=1&per_page=10",
              "protocol": "http",
              "host": ["127.0.0.1"],
              "port": "5000",
              "path": ["customers", ""],
              "query": [
                {"key": "page", "value": "1"},
                {"key": "per_page", "value": "10"}
              ]
            }
          }
        }
      ]
    },
